{
  "nodeVersion": "20",
  "cypress": {
    "configFile": "cypress.config.js"
  },
  "suites": [
    {
      "name": "default",
      "browser": "chrome",
      "browserVersion": "",
      "headless": true,
      "config": {
        "testingType": "e2e",
        "specPattern": [
          "**/expose.cy.js"
        ],
        "env": {
          "SHARED": "suite-value",
          "SAUCE_SUITE_NAME": "suite-override",
          "SAUCE_ARTIFACTS_DIRECTORY": "/suite/override",
          "CYPRESS_PREF": "pref-value"
        }
      }
    }
  ]
}
